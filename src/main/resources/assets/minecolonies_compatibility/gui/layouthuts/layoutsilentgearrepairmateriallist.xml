<window size="190 244" pause="false" lightbox="false">
	<image
		source="minecolonies:textures/gui/builderhut/builder_paper.png"
		size="190 244" />
	<label id="desc" size="130 11" pos="30 14" color="black"
		textalign="MIDDLE" />
	<text size="105 11" pos="20 32" textalign="MIDDLE_RIGHT"
		color="black"
		label="$(minecolonies_compatibility.text.can_use_higher)"
		tooltip="$(minecolonies_compatibility.text.can_use_higher.tooptip)" />
	<button id="canusehigher" pos="127 30" size="14 15"
		source="minecolonies:textures/gui/builderhut/builder_button_mini.png"
		disabled="minecolonies:textures/gui/builderhut/builder_button_mini_disabled.png" />

	<list id="resources" size="167 136" pos="13 50">
		<box size="100% 25" linewidth="1">
			<itemicon id="outputIcon" size="16 16" pos="2 4" />
			<label id="tierText" size="93 12" pos="20 1" color="black" />
			<label id="outputName" size="93 12" pos="20 13" color="black" />
			<buttonimage
				label="$(com.minecolonies.coremod.gui.recipe.remove)" id="switch"
				pos="113 5" size="45 15"
				source="minecolonies:textures/gui/builderhut/builder_button_very_small.png"
				textcolor="black" />
		</box>
	</list>
	<button id="crafting" size="129 17" pos="30 200" color="black"
		source="minecolonies:textures/gui/builderhut/builder_button_medium_large.png"
		label="$(minecolonies_compatibility.text.teach_repair_material)" />
</window>